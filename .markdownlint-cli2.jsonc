{
  "config": {
    "default": true,
    "line-length": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "no-inline-html": false,
    "first-line-heading": false,
    "table-column-style": false,
    "blanks-around-headings": false,
    "blanks-around-lists": false
  },
  "globs": ["docs/**/*.md", "README.md", "skills/**/*.md"],
  "ignores": [
    "node_modules",
    "dist",
    "CHANGELOG.md",
    "TASKS.md",
    "docs/design/plans/**",
    "docs/plans/**",
    "docs/tasks/T-53-runtime-verify-guide.md"
  ],
  "overrides": [
    {
      "filter": ["skills/**/*.md"],
      "config": {
        "blanks-around-fences": false
      },
      "combine": "merge"
    }
  ]
}
